{
  "name": "trainsmart-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TrainSmart - Hypertrophy Tracker Monorepo (Next.js, Laravel, Docusaurus)",
  "workspaces": [
    "frontend",
    "docs"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "build:frontend": "npm run build --workspace=frontend",
    "build:docs": "npm run build --workspace=docs",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:docs": "npm run dev --workspace=docs",
    "dev:backend": "php backend/artisan serve"
  },
  "devDependencies": {
    "turbo": "^2.1.0"
  }
}
